{
  "manifest_version": 2,
  "name": "自动化工具",
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon-128.png"
  },
  "background": {
    "scripts": [
      "async-lifecycle.js",
      "background.bundle.js"
    ]
  },
  "icons": {
    "128": "icon-128.png"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "打开工作流管理界面"
    },
    "element-picker": {
      "suggested_key": {
        "default": "Alt+P",
        "mac": "Alt+P"
      },
      "description": "打开元素选择器"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentScript.bundle.js"
      ],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "optional_permissions": [
    "clipboardRead",
    "downloads",
    "contextMenus",
    "notifications",
    "cookies"
  ],
  "permissions": [
    "tabs",
    "proxy",
    "alarms",
    "storage",
    "debugger",
    "<all_urls>",
    "webNavigation",
    "unlimitedStorage"
  ],
  "web_accessible_resources": [
    "/elementSelector.css",
    "/Inter-roman-latin.var.woff2",
    "/icon-128.png",
    "/locales/*",
    "elementSelector.bundle.js",
    "/NotoSansCJKsc-Regular.otf"
  ],
  "sandbox": {
    "pages": [
      "/sandbox.html"
    ]
  },
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "description": "面向 Chromium 90 的中文离线网页自动化工具，支持本地工作流、录制及加密备份。",
  "minimum_chrome_version": "90"
}